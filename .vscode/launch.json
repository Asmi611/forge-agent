{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (mock)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/fixtures/demo-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/../flask-demo/flask-A"
      ],
      "env": {
        "PATH": "${workspaceFolder}/../flask-demo/flask-A/.venv/Scripts;${env:PATH}"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask A (with extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../flask-demo/flask-A"
      ],
      "env": {
        "PATH": "${workspaceFolder}/../flask-demo/flask-A/.venv/Scripts;${env:PATH}"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask B",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/../flask-demo/flask-B"
      ],
      "env": {
        "PATH": "${workspaceFolder}/../flask-demo/flask-B/.venv/Scripts;${env:PATH}"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask C",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/../flask-demo/flask-C"
      ],
      "env": {
        "PATH": "${workspaceFolder}/../flask-demo/flask-C/.venv/Scripts;${env:PATH}"
      },
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    }
  ]
}
