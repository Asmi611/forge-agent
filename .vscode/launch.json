{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (mock)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/fixtures/demo-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/../flask-demo/flask-A"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "forge: build"
    },
    {
      "name": "Run Extension on Flask A (with extensions)",
      "type": "extensionHost",
